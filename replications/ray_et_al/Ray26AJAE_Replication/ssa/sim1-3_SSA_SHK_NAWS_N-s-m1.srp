! Miscellaneous info
! ------------------
!
!
! Shocks
! ------
!
! ************** !
! Shocks Section !
! ************** !
! df.known
! Change in crop production q_agg (2002-2017)  
Shock p_QAUGLANDz(US_CZ)        = file shf\OBS_DATA_TRIM.har   header "QAUG";
Shock p_PAUGLANDz(US_CZ)        = file shf\OBS_DATA_TRIM.har   header "PAUG";
Shock s_PCROPz(US_CZ)           = file shf\OBS_DATA_TRIM.har   header "PAGG";

! add change in water use and rent 
Shock p_QWATERz(US_CZ)          = file shf\OBS_DATA_TRIM.har    header "QWAT";
Shock p_PNLABORz(US_CZ)         = file shf\OBS_DATA_TRIM.har    header "PNLB";

! add shocks to land and labor
Shock s_QLANDz(US_CZ)           = file shf\OBS_DATA_TRIM.har    header "PHIC";
!Shock p_PLANDz(US_CZ)     = file shf\KNOWNPARM_PR01.har    header "PLND";
Shock s_QLABORz(US_CZ)          = file shf\NonAg_M_TRIM.har      header "PHIL";

! estimated PFP, ESLZ, ELAB
! PFP
Shock p_AFLABORz(US_CZ)    = file shf/FSE-NAWS_NM_TRIM.har header "AFL";
Shock p_AFNLABORz(US_CZ)   = file shf/FSE-NAWS_NM_TRIM.har header "AFZ";
Shock p_AFLANDWTRz(US_CZ)  = file shf/FSE-NAWS_NM_TRIM.har header "AFR";

! decompose
Subtotal p_QAUGLANDz(US_CZ) = Q;
Subtotal p_AFLABORz(US_CZ) = AFL;
Subtotal p_AFNLABORz(US_CZ) = AFZ;
Subtotal p_AFLANDWTRz(US_CZ) = AFR;
Subtotal s_QLANDz(US_CZ) = PHIC;
Subtotal s_QLABORz(US_CZ) = PHIL;
Subtotal p_QWATERz(US_CZ) = QW;
Subtotal p_PNLABORz(US_CZ) = PZ;

!Shock p_AFLANDWTRa(SHPR) = file shf\ESTIPARM-NAWS_N.har header "AFR";
!Shock p_AFLABORa(SHPR)   = file shf\ESTIPARM-NAWS_N.har header "AFL";
!Shock p_AFNLABORa(SHPR)  = file shf\ESTIPARM-NAWS_N.har header "AFZ";
