 ******************************************************************************


      1   !===========================================================================!
      2   !
      3   SIMPLEZ-US-EST at labor shed level
      4   This version is designed for Ray et al., 2025
      5   For first stage estimation (FSE) and hist. validation and Second stage estimation (SSE)
      6   Unknown parameters = {AFL,AFZ,AFR,ESLZ,ELAB}, read in from shf/ESTIPARM.har
      7   Initial values for {AO,AO,AO,0.26, abs[(ql(a)+phil(a))/pl(a)]}
      8   All (inputs & outputs) markets clear at the CZ level
      9    
     10   ****************************************************************************
     11      Basic model structure is as follows:
     12    
     13   **********
     14   * DEMAND *
     15   **********
     16    Change in production exogenously determined based on CoA Data
     17    
     18                                           |
     19   ********************                 QCROPz
     20   * SUPPLY STRUCTURE *                /      \
     21   ********************               /        \
     22                                     /----------\       <--ces
     23                                    /  ECROPz   \
     24                                   /              \
     25                             QAUGLANDz         QNITROz
     26                               /      \
     27                              /--------\                 <--ces
     28                             /EAUGLANDz\
     29                            /            \
     30                           /              \
     31                      QNLANDz         QLANDWTRz
     32                     /       \         /       \
     33                   /-ESUB_LZ-\        /         \
     34                 /           \       /-----------\        <--ces
     35             LABOR        NLABOR    /  EIRRIGz   \
     36                                   /              \
     37                               QLANDz           QWATERz
     38                                 /                  \
     39                                / ------------------ \  <--ces
     40                              /       ESUB_WKz       \
     41                             /                         \
     42                         QWATSGz                   QWEQPTz
     43                        /       \
     44                       /         \
     45                      /-----------\        <--ces
     46                     /  ESUB_SGz  \
     47                   /               \
     48               QWATSRFz        QWATGRDz
     49    !
     50    
     51    
     52    
     53   !<  PRELIMINARIES
     54       ====================================================================   >!
     55   !   Declaration of files & sets (see 'in' folder)                           !
     56   File  CZSETS    # model sets #;
     57         CZDATA    # model data #;
     58         CZPARM    # model parameters #;
     59         REGPARM   # model parameters #;
     60         LABMRKT   # file to sepcify the labor market shed for mig. lab #;
     61         ESTIPARM  # file with parameters to calibrate #;
     62    
     63   Set REG         # regions #                                    read elements from file CZSETS header "REG";
     64   Set CZ    # domestic labor market shed #                        read elements from file LABMRKT header "CZ";
     65   Set PR    # production regions #                                read elements from file LABMRKT header "SMKT";
     66    
     67   Mapping CZ2REG from CZ to REG;
     68               read CZ2REG from file  CZSETS header "MAP6";
     69    
     70   Mapping CZ2PR from CZ to PR;
     71               read CZ2PR from file  LABMRKT header "MAP4";
     72    
     73   Mapping PR2REG from PR to REG;
     74               read PR2REG from file  LABMRKT header "MP12";
     75    
     76   Set US_CZ   =(all,z,CZ:  CZ2REG(z)  = "US");
     77   Set US_PR   =(all,a,PR:  PR2REG(a)  = "US");
     78    
     79   !   **********************************
     80       Policy levers in Crop CES nest
     81       **********************************   !
     82    
     83   !   ****************************************
     84       Technical variables in Crop CES nest
     85       ****************************************   !
     86   ! technical change by by CZ !
     87   Variable  (all,z,CZ) p_AOCROPz(z);
     88   Variable  (all,z,CZ) p_AFNITROz(z)   # nitrogen eff. index in Crop prod. by CZ (z)#;
     89   Variable  (all,z,CZ) p_AFLANDz(z)    # land eff. index in crop prod. by CZ (z)#;
     90   Variable  (all,z,CZ) p_AFWATERz(z)   # aggregate irrigation eff. index in crop prod. by CZ (z)#;
     91   Variable  (all,z,CZ) p_AFWATSGz(z)   # water eff. index in crop prod. by CZ (z)#;
     92   Variable  (all,z,CZ) p_AFWEQPTz(z)   # water equipment eff. index in crop prod. by CZ (z)#;
     93   Variable  (all,z,CZ) p_AFLABORz(z)   # Labor eff. index in crop prod. by CZ (z)#;
     94   Variable  (all,z,CZ) p_AFNLABORz(z)  # Non-labor eff. index in crop prod. by CZ (z)#;
     95   Variable  (all,z,CZ) p_AFNLANDz(z)   # NonLand eff. index in crop prod. by CZ (z)#;
     96   Variable  (all,z,CZ) p_AFLANDWTRz(z) # Land+water eff. index in crop prod. by CZ (z)#;
     97    
     98   ! technical change by PR  !
     99   Variable  (all,a,PR) p_AFNITROa(a)   # N Fert eff. index in crop prod. by PR  #;
    100   Variable  (all,a,PR) p_AFNLANDa(a)   # NonLand eff. index in crop prod. by PR  #;
    101   Variable  (all,a,PR) p_AFLABORa(a)   # Labor eff. index in crop prod. by PR  #;
    102   Variable  (all,a,PR) p_AFNLABORa(a)   # Non-labor eff. index in crop prod. by PR  #;
    103   Variable  (all,a,PR) p_AFLANDWTRa(a) # Land+water eff. index in crop prod. by PR  #;
    104    
    105   ! technical change by reg  !
    106   Variable  (all,r,REG) p_AOCROPr(r) # input-neutral eff. index in Crop prod. by reg  #;
    107   Variable  (all,r,REG) p_AFNITROr(r) # nitrogen eff. index in Crop prod. by reg  #;
    108   Variable  (all,r,REG) p_AFLANDr(r) # land eff. index in crop prod. by reg  #;
    109   Variable  (all,r,REG) p_AFWATERr(r) # aggregate irrigation eff. index in crop prod. by reg #;
    110   Variable  (all,r,REG) p_AFWATSGr(r) # water eff. index in crop prod. by reg  #;
    111   Variable  (all,r,REG) p_AFWEQPTr(r) # water equipment eff. index in crop prod. by reg  #;
    112   Variable  (all,r,REG) p_AFLABORr(r) # Labor eff. index in crop prod. by PR #;
    113   Variable  (all,r,REG) p_AFNLABORr(r) # Non-labor eff. index in crop prod. by PR #;
    114   Variable  (all,r,REG) p_AFNLANDr(r) # NonLand eff. index in crop prod. by reg  #;
    115   Variable  (all,r,REG) p_AFLANDWTRr(r) # Land+water eff. index in crop prod. by reg  #;
    116    
    117   ! final technical change variable !
    118   Variable  (all,z,CZ) p_AOCROP(z) # input-neutral eff. index in Crop prod. by CZ (z)#;
    119   Variable  (all,z,CZ) p_AFNITRO(z) # nitrogen eff. index in Crop prod. by CZ (z)#;
    120   Variable  (all,z,CZ) p_AFLAND(z) # land eff. index in crop prod. by CZ (z)#;
    121   Variable  (all,z,CZ) p_AFWATER(z) # aggregate irrigation eff. index in crop prod. by CZ (z)#;
    122   Variable  (all,z,CZ) p_AFWATSG(z) # water eff. index in crop prod. by CZ (z)#;
    123   Variable  (all,z,CZ) p_AFWEQPT(z) # water equipment eff. index in crop prod. by CZ (z)#;
    124   Variable  (all,z,CZ) p_AFLABOR(z) # Labor eff. index in crop prod. by CZ (z)#;
    125   Variable  (all,z,CZ) p_AFNLABOR(z) # Non-labor eff. index in crop prod. by CZ (z)#;
    126   Variable  (all,z,CZ) p_AFNLAND(z) # NonLand eff. index in crop prod. by CZ (z)#;
    127   Variable  (all,z,CZ) p_AFLANDWTR(z) # Land+water eff. index in crop prod. by CZ (z)#;
    128    
    129   !   Equation linking regional and grid specific tech change parameters      !
    130   Equation
    131    E_AOCROP     (all,z,CZ) p_AOCROP(z)    = p_AOCROPz(z)     + p_AOCROPr(CZ2REG(z));
    132    E_AFNITRO    (all,z,CZ) p_AFNITRO(z)   = p_AFNITROz(z)    + p_AFNITROa(CZ2PR(z)) + p_AFNITROr(CZ2REG(z));
    133    E_AFLAND     (all,z,CZ) p_AFLAND(z)    = p_AFLANDz(z)     + p_AFLANDr(CZ2REG(z));
    134    E_AFWATER    (all,z,CZ) p_AFWATER(z)   = p_AFWATERz(z)    + p_AFWATERr(CZ2REG(z));
    135    E_AFWATSG    (all,z,CZ) p_AFWATSG(z)   = p_AFWATSGz(z)    + p_AFWATSGr(CZ2REG(z));
    136    E_AFWEQPT    (all,z,CZ) p_AFWEQPT(z)   = p_AFWEQPTz(z)    + p_AFWEQPTr(CZ2REG(z));
    137    E_AFLABOR    (all,z,CZ) p_AFLABOR(z)   = p_AFLABORz(z)    + p_AFLABORa(CZ2PR(z)) + p_AFLABORr(CZ2REG(z));
    138    E_AFNLABOR   (all,z,CZ) p_AFNLABOR(z)  = p_AFNLABORz(z)   + p_AFNLABORa(CZ2PR(z))   + p_AFNLABORr(CZ2REG(z));
    139    E_AFNLAND    (all,z,CZ) p_AFNLAND(z)   = p_AFNLANDz(z)    + p_AFNLANDa(CZ2PR(z))   + p_AFNLANDr(CZ2REG(z));
    140    E_AFLANDWTR  (all,z,CZ) p_AFLANDWTR(z) = p_AFLANDWTRz(z)  + p_AFLANDWTRa(CZ2PR(z)) + p_AFLANDWTRr(CZ2REG(z));
    141    
    142   !   ******************************
    143       Control/slack variables
    144       ******************************   !
    145   Variable
    146    (all,z,CZ)  s_QLANDz(z)     # Slack to control cropland by CZ (z) #;
    147    (all,z,CZ)  s_QWATERz(z)    # Slack to control water use by CZ (z) #;
    148    (all,z,CZ)  s_QCROPz(z)     # Slack to control crop output by CZ #;
    149    (all,z,CZ)  s_PCROPz(z)     # dictate CZ level crop price #;
    150    (all,z,CZ)  s_QLANDWTRz(z)  # supply shock to composite land+wtr (z) #;
    151    (all,z,CZ)  s_QAUGLANDz(z)  # #;
    152    (all,z,CZ)  s_QNLANDz(z)    # QNLAND slack # ;
    153    (all,z,CZ)  s_PNLANDz(z)    ;
    154    (all,z,CZ)  s_QLABORz(z)    ;
    155    (all,a,PR)  s_QLABORa(a)    ;
    156    (all,z,CZ)  s_QLABOR(z)    ;
    157    (all,z,CZ)  s_QNLABORz(z) # Slack to control non-labor market by grid & ltype #;
    158    
    159   Equation
    160    E_SQLABOR     (all,z,CZ) s_QLABOR(z)    = s_QLABORz(z)     + s_QLABORa(CZ2PR(z));
    161    
    162   !<  PRODUCTION SYSTEM
    163       ====================================================================   >!
    164    
    165   ! define main inputs and assign values!
    166   Variable
    167    (levels) (all,z,CZ) QLANDz(z)     # cropland area by a (z) (1000 HA) #;
    168    (levels)(all,z,CZ)  QLABORz(z)    # Labor in a commuting zone (in 1000 hours) #;
    169   ! (levels)(all,z,CZ)  QNLABORz(z)   # Non-Labor in a commuting zone (in 1000 hours) #;!
    170    (levels)(all,z,CZ)  PCROPz(z)     # price of crops by CZ ($/kg corn-eq) #;
    171    (levels)(all,z,CZ)  QCROPz(z)     # crop output by CZ    (1000 kg) #;
    172    
    173   Coefficient
    174    (all,z,CZ) VLANDz(z)    # Val land      by a (z) (1000 USD) #;
    175    (all,z,CZ) VLABORz(z)   # Val labor     by a (z) (1000 USD) #;
    176    (all,z,CZ) VNLABORz(z)  # Val non-labor by a (z) (1000 USD) #;
    177    (all,z,CZ) VNITROz(z)   # Val nitr frt  by a (z) (1000 USD) #;
    178    (all,z,CZ) VWATSGz(z)   # Val water     by a (z) (1000 USD) #;
    179    (all,z,CZ) VWEQPTz(z)   # Val wat eqpt  by a (z) (1000 USD) #;
    180    
    181   Read
    182    QLANDz   from file CZDATA header "QLND";
    183    QLABORz  from file CZDATA header "QLAB";
    184   ! QNLABORz from file CZDATA header "QNLB";!
    185    QCROPz   from file CZDATA header "QCRP";
    186    
    187    VLANDz   from file CZDATA header "VLND";
    188    VLABORz  from file CZDATA header "VLAB";
    189    VNLABORz from file CZDATA header "VNLB";
    190    VNITROz  from file CZDATA header "VNIT";
    191    VWATSGz  from file CZDATA header "VWTR";
    192    VWEQPTz  from file CZDATA header "VWOR";
    193    
    194   Coefficient
    195   (all,z,CZ) VCROPz(z)    # Val crop output   by z (1000 USD) #;
    196   (all,z,CZ) VWATERz(z)   # Val irrigation    by z (1000 USD) #;
    197   (all,z,CZ) VLNDWTRz(z)  # Val land+irrig    by z (1000 USD) #;
    198   (all,z,CZ) VNLANDz(z)   # Val lan+non-lab   by z (1000 USD) #;
    199   (all,z,CZ) VAUGLANDz(z) # Val oth+lnd+irrig by z (1000 USD) #;
    200    
    201   Formula
    202   (all,z,CZ) VWATERz(z)   = VWATSGz(z) + VWEQPTz(z);
    203   (all,z,CZ) VLNDWTRz(z)  = VWATERz(z) + VLANDz(z) ;
    204   (all,z,CZ) VNLANDz(z)   = VLABORz(z) + VNLABORz(z) ;
    205   (all,z,CZ) VAUGLANDz(z) = VNLANDz(z) + VLNDWTRz(z) ;
    206   (all,z,CZ) VCROPz(z)    = VNITROz(z) + VAUGLANDz(z) ;
    207    
    208   Coefficient
    209    (all,z,CZ)  SHR_LinNLz(z)  # shr labor in non-land by CZ #;
    210    (all,z,CZ)  SHR_CinNLz(z)  # shr capital in non-land by CZ #;
    211    (all,z,CZ)  SHR_LABORz(z)  # shr labor in tot cost by CZ #;
    212    (all,z,CZ)  SHR_NLABORz(z) # shr non-labor in tot cost by CZ #;
    213    
    214   Zerodivide default 0.20;
    215   Formula
    216             (all,z,CZ)   SHR_LABORz(z)  = VLABORz(z)  / VCROPz(z);
    217             (all,z,CZ)   SHR_NLABORz(z) = VNLABORz(z) / VCROPz(z);
    218             (all,z,CZ)   SHR_LinNLz(z)  = VLABORz(z)  / VNLANDz(z);
    219             (all,z,CZ)   SHR_CinNLz(z)  = VNLABORz(z) / VNLANDz(z);
    220   Zerodivide off;
    221    
    222   ! define share parameters and assign values!
    223   Coefficient
    224   ! shr: cost shares!
    225   (all,z,CZ) SHR_LANDz(z)   # shr land  in tot cost by CZ #;
    226   (all,z,CZ) SHR_NITROz(z)  # shr nitr  in tot cost by CZ #;
    227   (all,z,CZ) SHR_WATSGz(z)  # shr water S+G   in tot cost by CZ #;
    228   (all,z,CZ) SHR_WEQPTz(z)  # shr water equipment in tot cost by CZ #;
    229   (all,z,CZ) SHR_NLANDz(z)  # shr non-land in tot cost by CZ #;
    230    
    231   (all,z,CZ) SHR_OinAUGz(z) # shr oth   in aug. land by CZ (z) #;
    232   (all,z,CZ) SHR_LinAUGz(z) # shr land  in aug. land by CZ (z) #;
    233   (all,z,CZ) SHR_WinAUGz(z) # shr water in aug. land by CZ (z) #;
    234   (all,z,CZ) SHR_LinLWz(z)  # shr land  in land+wat+eqpt by CZ (z) #;
    235   (all,z,CZ) SHR_WinLWz(z)  # shr water in land+wat+eqpt by CZ (z) #;
    236   (all,z,CZ) SHR_WWinWz(z)  # shr wat S+G in wat+eqpt by CZ (z) #;
    237   (all,z,CZ) SHR_WKinWz(z)  # shr Weqpt in wat+eqpt by CZ (z) #;
    238    
    239   ! QCET !
    240   ! shr: quantity shares!
    241   Coefficient
    242   (all,z,CZ) SHR_QLANDz(z) # quantity shr of each land type in CET by a #;
    243   ! shr: revenue shares!
    244   (all,z,CZ) SHR_VLANDz(z) # shr each land type in CET by a #;
    245    
    246   Formula
    247    (all,z,CZ) SHR_LANDz(z)  = VLANDz(z)  / VCROPz(z);
    248    (all,z,CZ) SHR_NITROz(z) = VNITROz(z) / VCROPz(z);
    249    (all,z,CZ) SHR_WATSGz(z) = VWATSGz(z) / VCROPz(z);
    250    (all,z,CZ) SHR_WEQPTz(z) = VWEQPTz(z) / VCROPz(z);
    251    (all,z,CZ) SHR_NLANDz(z) = VNLANDz(z) / VCROPz(z);
    252    
    253   Zerodivide default 0.333333;
    254   Formula
    255    (all,z,CZ) SHR_OinAUGz(z) = VNLANDz(z) / VAUGLANDz(z);
    256    (all,z,CZ) SHR_LinAUGz(z) = VLANDz(z)  / VAUGLANDz(z);
    257    (all,z,CZ) SHR_WinAUGz(z) = VWATERz(z) / VAUGLANDz(z);
    258    
    259   Zerodivide default 0.50;
    260   Formula
    261    (all,z,CZ) SHR_WinLWz(z) = VWATERz(z) / VLNDWTRz(z) ;
    262    (all,z,CZ) SHR_LinLWz(z) = VLANDz(z)  / VLNDWTRz(z);
    263    
    264   Zerodivide default 0.5;
    265   Formula
    266    (all,z,CZ) SHR_WWinWz(z) = VWATSGz(z) / VWATERz(z);
    267    (all,z,CZ) SHR_WKinWz(z) = VWEQPTz(z) / VWATERz(z);
    268   Zerodivide off;
    269    
    270   Coefficient
    271    (Parameter) (all,z,CZ)  ECROPz(z)    # Elas. of subs. in crop production by grid & ltype #;
    272    (Parameter) (all,z,CZ)  EIRRIGz(z)   # Elas. of subs. between land & water by grid #;
    273    (Parameter) (all,z,CZ)  EAUGLANDz(z) # Elas. of subs. between humand and resources by PR #;
    274    (Parameter) (all,z,CZ)  ESUB_WKz(z)  # Elas. of subs. in wat+eqpt CES nest by grid & ltype #;
    275    (Parameter) (all,z,CZ)  EWATSGz(z)   # supply elas. of water by grid & ltype#;
    276    (Parameter) (all,z,CZ)  ELANDz(z)    # supply elas. of land #;
    277    (Parameter) (all,r,REG) ENITROr(r)   # supply elas. of nitrogen  by reg #;
    278    (Parameter) (all,r,REG) EWATKLr(r)   # supply elas. of irrig eqpt  by reg #;
    279    
    280   Read
    281    ECROPz       from file CZPARM   header "ECRP";
    282    EIRRIGz      from file CZPARM   header "EIRR";
    283    EAUGLANDz    from file CZPARM   header "EAUG"; !=0.5!
    284    ESUB_WKz     from file CZPARM   header "EWAT"; ! 0.5 !
    285    EWATSGz      from file CZPARM   header "EWTR";
    286    ELANDz       from file CZPARM   header "ELND";
    287    ENITROr      from file REGPARM header "ENTR";
    288    EWATKLr      from file REGPARM header "EWKL";
    289    
    290   Variable
    291    (all,z,CZ)  p_QNITROz(z) # nitrogen use by CZ   #;
    292    (all,z,CZ)  p_PNITROz(z) # price of nitrogen use by CZ #;
    293    (all,z,CZ)  p_QWATSGz(z) # water use by CZ      #;
    294    (all,z,CZ)  p_PWATSGz(z) # price of water use by CZ    #;
    295    (all,z,CZ)  p_PLANDz(z)  # price of cropland by CZ     #;
    296    (all,z,CZ)  p_QNLANDz(z) # other input by CZ           #;
    297    (all,z,CZ)  p_PNLANDz(z) # price of other input by CZ  #;
    298    (all,z,CZ)  p_QWEQPTz(z) # irrig eqpt by CZ            #;
    299    (all,z,CZ)  p_PWEQPTz(z) # price of irrig eqpt by CZ   #;
    300    (all,z,CZ)  p_PAUGLANDz(z) # price of aug. land by CZ     #;
    301    (all,z,CZ)  p_QAUGLANDz(z) # quantity of aug. land by CZ  #;
    302    (all,z,CZ)  p_PLANDWTRz(z) # price of land+irrig by CZ    #;
    303    (all,z,CZ)  p_QLANDWTRz(z) # quantity of land+irrig by CZ #;
    304    (all,z,CZ)  p_PWATERz(z)  # price of water+eqpt by CZ    #;
    305    (all,z,CZ)  p_QWATERz(z)  # quantity of water+eqpt by CZ #;
    306    (all,z,CZ)  p_VCROPz(z);
    307    
    308   Update
    309    (all,z,CZ) VLANDz(z)  = p_PLANDz(z)  * p_QLANDz(z);
    310    (all,z,CZ) VNITROz(z) = p_PNITROz(z) * p_QNITROz(z);
    311    (all,z,CZ) VWATSGz(z) = p_PWATSGz(z) * p_QWATSGz(z);
    312    (all,z,CZ) VWEQPTz(z) = p_PWEQPTz(z) * p_QWEQPTz(z);
    313   ! (all,z,CZ) VNLANDz(z) = p_PNLANDz(z)*p_QNLANDz(z);
    314    (all,z,CZ) VLNDWTRz(z) = p_PLANDWTRz(z)*p_QLANDWTRz(z);!
    315    
    316   ![[! start--- water module by source !]]!
    317   Coefficient
    318   ! water by source!
    319    (all,z,CZ) QWATSRFz(z) # vol surface water by a (xx m3) #;
    320    (all,z,CZ) QWATGRDz(z) # vol groundwater   by a (xx m3) #;
    321   ! shr: vol shares!
    322    (all,z,CZ) SHR_SinSGz(z) # shr srf  in tot water by g&l #;
    323    (all,z,CZ) SHR_GinSGz(z) # shr grd  in tot water by g&l #;
    324    
    325   Read
    326    QWATSRFz  from file CZDATA header "QSRF";
    327    QWATGRDz  from file CZDATA header "QGRD";
    328    
    329   Zerodivide default 0.50;
    330   Formula
    331    (all,z,CZ) SHR_SinSGz(z) = QWATSRFz(z)  / [QWATSRFz(z)+QWATGRDz(z)];
    332    (all,z,CZ) SHR_GinSGz(z) = QWATGRDz(z)  / [QWATSRFz(z)+QWATGRDz(z)];
    333   Zerodivide off;
    334    
    335   Coefficient
    336    (Parameter) (all,z,CZ)  ETA_WATSRFz(z) # supply elasticity of surface water #;
    337    (Parameter) (all,z,CZ)  ETA_WATGRDz(z) # supply elasticity of groundwater #;
    338    (Parameter) (all,z,CZ)  ESUB_SGz(z)    # substitution elasticity between groundwater and surface water #;
    339    
    340   Read
    341    ETA_WATSRFz   from file CZPARM header "ETAS";
    342    ETA_WATGRDz   from file CZPARM header "ETAG";
    343    ESUB_SGz      from file CZPARM header "ESW";
    344    
    345   Variable
    346    (all,z,CZ) p_QWATSRFz(z)  # vol of surface water withdrawal by CZ #;
    347    (all,z,CZ) p_QWATGRDz(z)  # vol of groundwater withdrawal by CZ  #;
    348    (all,z,CZ) p_PWATSRFz(z)  # price of surface water by CZ #;
    349    (all,z,CZ) p_PWATGRDz(z)  # price of groundwater by CZ  #;
    350    (all,z,CZ) s_QWATSRFz(z)  # slack for surface water withdrawal by CZ #;
    351    (all,z,CZ) s_QWATGRDz(z)  # slack for groundwater withdrawal by CZ  #;
    352    (all,z,CZ) t_PAUGLANDz(z) ;
    353    (all,z,CZ) t_PNITROz(z);
    354    (all,z,CZ) t_PNLABORz(z);
    355    
    356   Equation
    357    E_PWATSRFz (all,z,CZ) p_QWATSRFz(z)  = ETA_WATSRFz(z) * p_PWATSRFz(z) + s_QWATSRFz(z);
    358    E_PWATGRDZ (all,z,CZ) p_QWATGRDz(z)  = ETA_WATGRDz(z) * p_PWATGRDz(z) + s_QWATGRDz(z);
    359    E_QWATSRFZ (all,z,CZ) p_QWATSRFz(z)  = p_QWATSGz(z) - ESUB_SGz(z) * [p_PWATSRFz(z) - p_PWATSGz(z)];
    360    E_QWATGRDz (all,z,CZ) p_QWATGRDz(z)  = p_QWATSGz(z) - ESUB_SGz(z) * [p_PWATGRDz(z) - p_PWATSGz(z)];
    361   !price index for srf + grd water!
    362    E_PWATSGz  (all,z,CZ) p_PWATSGz(z)   = SHR_SinSGz(z) * [p_PWATSRFz(z) ]
    363                                         + SHR_GinSGz(z) * [p_PWATGRDz(z) ];
    364   Update
    365    (all,z,CZ) QWATSRFz(z) = p_QWATSRFz(z);
    366    (all,z,CZ) QWATGRDz(z) = p_QWATGRDz(z);
    367    
    368   ![[! water module by source --- end !]]!
    369    
    370   ![[! labor module by types  --- start !]]!
    371   Coefficient
    372    (Parameter) (all,a,PR) ELABORa(a) # calibrating labor ss at the CZ level # ;
    373    (Parameter) (all,a,PR) ESUB_LZa(a)   # Elas. of subs. bet. labor and capital in NLAND nest CZ & ltype #;
    374    (parameter) ENLABORr ;
    375    
    376   Read
    377    ELABORa    from file ESTIPARM header "ELAB"; ! calculated from labor ss equation !
    378    ESUB_LZa   from file ESTIPARM header "ESLZ"; !0.2!
    379    ENLABORr   from file CZPARM   header "ENL6";
    380    
    381   Variable
    382    (all,z,CZ)  p_QNLABORz(z)       # Change in use of non-labor in a CZ #;
    383    (all,z,CZ)  p_PNLABORz(z)       # Change in cost of non-labor in a CZ #;
    384    (all,z,CZ)  p_PLABORz(z)        # Change in wages in a CZ #;
    385    
    386   ! labor market equations!
    387   Equation
    388   ! Demand of labor by CZ!
    389   E_QLABORz (all,z,CZ)
    390       p_QLABORz(z) + p_AFLABOR(z)
    391           = p_QNLANDz(z) - ESUB_LZa(CZ2PR(z)) * [p_PLABORz(z) - p_AFLABOR(z) - p_PNLANDz(z)] ;
    392    
    393   !price index for mlab+llab for labor !
    394   E_PLABORz  (all,z,CZ)
    395   !to be consistent with analytical derivation supply shock is introduced with a - sign!
    396    p_QLABORz(z) = ELABORa(CZ2PR(z)) * p_PLABORz(z) - s_QLABOR(z);
    397    
    398   ! Demand of non-labor by grid (z)!
    399   E_QNLABORz (all,z,CZ)
    400       p_QNLABORz(z) + p_AFNLABOR(z)
    401           = p_QNLANDz(z) - ESUB_LZa(CZ2PR(z)) * [p_PNLABORz(z) - p_AFNLABOR(z) - p_PNLANDz(z)] + s_QNLABORz(z);
    402    
    403   E_PNLABORz (all,z,CZ)
    404    p_QNLABORz(z) = ENLABORr * p_PNLABORz(z) + t_PNLABORz(z);
    405    
    406   !price index for lab+nlab water!
    407    E_PNLANDz  (all,z,CZ)
    408       p_PNLANDz(z)
    409        = SHR_LinNLz(z) * [p_PLABORz(z) -  p_AFLABOR(z)]
    410        + SHR_CinNLz(z) * [p_PNLABORz(z) - p_AFNLABOR(z)] + s_PNLANDz(z);
    411    
    412   Update
    413    (all,z,CZ)  VLABORz(z)   = p_PLABORz(z) * p_QLABORz(z);
    414    (all,z,CZ)  VNLABORz(z)  = p_PNLABORz(z) *p_QNLABORz(z);
    415    
    416   Equation
    417   !supply of total cropland!
    418   !to be consistent with analytical derivation supply shock is introduced with a - sign!
    419   E_PLANDz (all,z,CZ) p_QLANDz(z) = ELANDz(z) *  p_PLANDz(z) - s_QLANDz(z);
    420    
    421   !demand of cropland!
    422   E_QLANDz (all,z,CZ)
    423     p_QLANDz(z) + p_AFLAND(z)
    424        = p_QLANDWTRz(z) - EIRRIGz(z) * [p_PLANDz(z) - p_AFLAND(z) - p_PLANDWTRz(z)] ;
    425    
    426   !supply of irrigation equipments etc!
    427   E_PWEQPTz (all,z,CZ) p_QWEQPTz(z) = EWATKLr(CZ2REG(z))  * p_PWEQPTz(z);
    428    
    429   !Demand for nitrogen fertilizer input !
    430   E_QNITROz (all,z,CZ)
    431     p_QNITROz(z) + p_AFNITRO(z)
    432        = p_QCROPz(z) - p_AOCROP(z) - ECROPz(z) * [p_PNITROz(z) - p_AFNITRO(z) - p_PCROPz(z)  - p_AOCROP(z) ];
    433    
    434   E_PNITROz (all,z,CZ)
    435    p_QNITROz(z) = ENITROr(CZ2REG(z)) * p_PNITROz(z) + t_PNITROz(z);
    436    
    437   !Demand for water (surface water + groundwater) input!
    438   E_QWATSGz (all,z,CZ) p_QWATSGz(z) + p_AFWATSG(z)
    439         = p_QWATERz(z)               - ESUB_WKz(z)  * [p_PWATSGz(z) - p_AFWATSG(z) - p_PWATERz(z)] ;
    440    
    441   !Demand for irrigation equipments!
    442   E_QWEQPTz  (all,z,CZ) p_QWEQPTz(z) + p_AFWEQPT(z)
    443        = p_QWATERz(z)                - ESUB_WKz(z)  * [p_PWEQPTz(z) - p_AFWEQPT(z) - p_PWATERz(z) ] ;
    444    
    445   !Demand for other inputs!
    446   E_QNLANDz (all,z,CZ) p_QNLANDz(z) + p_AFNLAND(z)
    447        = p_QAUGLANDz(z)              - EAUGLANDz(z) * [p_PNLANDz(z) - p_AFNLAND(z)  - p_PAUGLANDz(z) ] + s_QNLANDz(z) ;
    448    
    449   !Quantity index for oth+land+water+eqpt!
    450   E_QAUGLANDz  (all,z,CZ) p_QAUGLANDz(z)
    451        = p_QCROPz(z)  - p_AOCROP(z) - ECROPz(z) * [p_PAUGLANDz(z) - p_PCROPz(z) - p_AOCROP(z)] + s_QAUGLANDz(z);
    452    
    453   !Quantity index for water+eqpt!
    454   E_QWATERz   (all,z,CZ) p_QWATERz(z) + p_AFWATER(z)
    455        = p_QLANDWTRz(z)              - EIRRIGz(z)  * [p_PWATERz(z) - p_AFWATER(z) - p_PLANDWTRz(z)] + s_QWATERz(z);
    456    
    457   !Quantity index for land+water+eqpt!
    458   E_QLANDWTRz (all,z,CZ) p_QLANDWTRz(z) + p_AFLANDWTR(z)
    459        = p_QAUGLANDz(z)              - EAUGLANDz(z) * [p_PLANDWTRz(z) - p_AFLANDWTR(z) - p_PAUGLANDz(z) ] + s_QLANDWTRz(z);
    460    
    461   !price index for irrigation wat+eqpt!
    462   E_PWATERz  (all,z,CZ)
    463    p_PWATERz(z) = SHR_WWinWz(z) * [p_PWATSGz(z) - p_AFWATSG(z)]
    464                 + SHR_WKinWz(z) * [p_PWEQPTz(z) - p_AFWEQPT(z)];
    465    
    466   !price index for land+water+eqpt!
    467   E_PLANDWTRz  (all,z,CZ)
    468   p_PLANDWTRz(z)
    469        = SHR_LinLWz(z) * [p_PLANDz(z)  - p_AFLAND(z)]
    470        + SHR_WinLWz(z) * [p_PWATERz(z) - p_AFWATER(z)];
    471    
    472   !price index for oth+land+water+eqpt!
    473   E_PAUGLANDz  (all,z,CZ)
    474   p_PAUGLANDz(z)
    475        = SHR_OinAUGz(z) * [p_PNLANDz(z)- p_AFNLAND(z)]
    476        + SHR_LinAUGz(z) * [p_PLANDz(z) - p_AFLAND(z) ]
    477        + SHR_WinAUGz(z) * [p_PWATERz(z)- p_AFWATER(z)] + t_PAUGLANDz(z);
    478    
    479   !alternative form of zero profit condition!
    480   ! SR: omit, redefined in 'start PR'!
    481   E_QCROPz     (all,z,CZ)
    482   p_QCROPz(z)
    483        = SHR_LANDz(z)   * [p_QLANDz(z)   + p_AFLAND(z)  ]
    484        + SHR_NITROz(z)  * [p_QNITROz(z)  + p_AFNITRO(z) ]
    485        + SHR_LABORz(z)  * [p_QLABORz(z)  + p_AFLABOR(z)]
    486        + SHR_NLABORz(z) * [p_QNLABORz(z) + p_AFNLABOR(z)]
    487        + SHR_WATSGz(z)  * [p_QWATSGz(z)  + p_AFWATSG(z) + p_AFWATER(z)]
    488        + SHR_WEQPTz(z)  * [p_QWEQPTz(z)  + p_AFWEQPT(z) + p_AFWATER(z)]
    489        + p_AOCROP(z) + s_QCROPz(z);
    490    
    491   ! CZ level clearing of Crop and NIT markets !
    492   E_PCROPz (all,z,CZ)
    493   p_PCROPz(z) = s_PCROPz(z);
    494    
    495   E_VCROPz (all,z,CZ)
    496   p_VCROPz(z) = p_QCROPz(z) + p_PCROPz(z);
    497    
    498   !
    499   *****************************************************************************
    500                    Regional markets: eliminated
    501   *****************************************************************************
    502   !
    503   ![[!
    504   ! regional aggregates: crops, nitrogen , non-labor !
    505   Variable
    506   (all,r,REG)          p_QNITROr(r) # Nitrogen use by reg (in 1000 MT) #;
    507   (all,r,REG)          p_PNITROr(r) # Price of nitrogen by reg (in USD/MT) #;
    508   (all,z,CZ)           t_PNITROz(z);
    509    
    510   Coefficient
    511    (all,r,REG)        VNITROr(r) # Value of Nit. fert. by reg (in 1000 USD) #;
    512    
    513   Formula
    514    (all,r,REG)         VNITROr(r) = sum(z, CZ:CZ2REG(z)=r, VNITROz(z));
    515    
    516   Equation
    517   E_PNITROz  (all,z,CZ) p_PNITROz(z) = p_PNITROr(CZ2REG(z)) + t_PNITROz(z);
    518   E_QNITROr  (all,r,REG) p_QNITROr(r) = ENITROr(r) * p_PNITROr(r);
    519   E_PNITROr  (all,r,REG) VNITROr(r)*p_QNITROr(r) = sum{z,CZ:CZ2REG(z)=r, VNITROz(z)*p_QNITROz(z)};
    520    
    521   ! regional market / price for non-lab fertilizer !
    522   Variable
    523   (all,r,REG)          p_QNLABORr(r) # Nitrogen use by reg (in 1000 MT) #;
    524   (all,r,REG)          p_PNLABORr(r) # Price of nitrogen by reg (in USD/MT) #;
    525   (all,z,CZ)          t_PNLABORz(z);
    526    
    527   Coefficient
    528    (all,r,REG)        VNLABORr(r) # Value of Nit. fert. by reg (in 1000 USD) #;
    529    
    530   Formula
    531    (all,r,REG)         VNLABORr(r) = sum(z, CZ:CZ2REG(z)=r, VNLABORz(z));
    532    
    533   Equation
    534   E_PNLABORz  (all,z,CZ) p_PNLABORz(z) = p_PNLABORr(CZ2REG(z)) + t_PNLABORz(z);
    535   E_QNLABORr  (all,r,REG) p_QNLABORr(r) = ENLABORr * p_PNLABORr(r);
    536   E_PNLABORr  (all,r,REG) VNLABORr(r)*p_QNLABORr(r) = sum{z,CZ:CZ2REG(z)=r, VNLABORz(z)*p_QNLABORz(z)};
    537    
    538    
    539   Variable
    540   (levels) (all,r,REG) QCROPr(r) # Crop output by reg (in 1000 MT: Corn-eq.) #;
    541   (levels) (all,r,REG) PCROPr(r)  # Crop price by reg (in USD / MT)#;
    542   (levels) (all,r,REG) VCROPr(r)  # Value of crop output by reg (in 1000 USD) #;
    543    
    544   Formula
    545    (initial)(all,r,REG)              VCROPr(r)    =  sum(z, CZ:CZ2REG(z) EQ r, VCROPz(z));
    546    (initial)(all,r,REG)              QCROPr(r)    =  sum(z, CZ:CZ2REG(z) EQ r, QCROPz(z));
    547    (initial)(all,r,REG)              PCROPr(r)    = VCROPr(r)/QCROPr(r);
    548    (initial)(all,z,CZ) PCROPz(z) = PCROPr(CZ2REG(z));
    549    
    550   Equation
    551   E_PCROPz  (all,z,CZ) p_PCROPz(z) = p_PCROPr(CZ2REG(z)) ;
    552   E_QCROPr  (aLL,r,REG)              VCROPr(r)*p_QCROPr(r) = sum{z,CZ:CZ2REG(z)=r, VCROPz(z)*p_QCROPz(z)};
    553   E_VCROPr  (aLL,r,REG)              p_VCROPr(r) = p_QCROPr(r) + p_PCROPr(r);
    554   !]]!
    555    
    556   !<  --------------------------------------------------------------------
    557       condensation to make the model solve faster
    558      --------------------------------------------------------------------    >!
    559    
    560   Substitute p_AOCROP  using E_AOCROP;
    561   Substitute p_AFNITRO using E_AFNITRO;
    562   Substitute p_AFLAND  using E_AFLAND;
    563   Substitute p_AFNLAND using E_AFNLAND;
    564   Substitute p_AFWATER using E_AFWATER;
    565   Substitute p_AFWATSG using E_AFWATSG;
    566   Substitute p_AFWEQPT using E_AFWEQPT;
    567    
    568   Substitute  p_PWEQPTz using E_PWEQPTz ;
    569   Substitute  p_QWEQPTz using E_QWEQPTz ;
    570    
    571   Substitute  p_QNLANDz using E_QNLANDz ;
    572    
    573   Backsolve p_PLANDWTRz using E_PLANDWTRz ;
    574   Backsolve p_PWATERz   using E_PWATERz ;
    575    
    576   Substitute  p_QWATSRFz using E_QWATSRFz ;
    577   Substitute  p_QWATGRDz using E_QWATGRDz ;
    578   Substitute  p_PWATSRFz using E_PWATSRFz ;
    579   Substitute  p_PWATGRDz using E_PWATGRDz ;
    580    
    581   Substitute  p_QWATSGz  using E_QWATSGz ;
    582   Substitute  p_PNLANDz  using E_PNLANDz ;
    583   Substitute  p_PWATSGz  using E_PWATSGz ;
    584   Substitute  p_QNITROz  using E_QNITROz ;
    585   Substitute  p_PNITROz  using E_PNITROz ;
    586    
    587   Omit s_QLANDWTRz ;
    588   Omit s_QCROPz;
    589    
    590   ! labor!
    591   Omit s_QNLANDz;
    592   Omit s_PNLANDz;
    593   Omit s_QNLABORz;
    594   Omit s_QWATGRDz;
    595   Omit s_QWATSRFz;
    596    
    597   ! PFP !
    598   !Omit p_AFLABORz;
    599   Omit p_AFNITROz  ;
    600   Omit p_AFLANDz  ;
    601   Omit p_AFNLANDz  ;
    602   Omit p_AFLANDWTRz  ;
    603   Omit p_AFWATERz  ;
    604   Omit p_AFWATSGz  ;
    605   Omit p_AFWEQPTz  ;
    606   Omit p_AFNLABORz  ;!
    607    
    608   !====================================================!
    609   ! **** Aggregate CZ level results to labor shed **** !
    610   !====================================================!
    611    
    612   ! calculate labor market outcomes at PR!
    613   Variable (all,z,CZ)  p_VLABORz(z);
    614   Variable (all,a,PR) p_PLABORa(a);
    615   Variable (all,a,PR) p_QLABORa(a);
    616   Variable (all,a,PR) p_VLABORa(a);
    617    
    618   Coefficient (all,a,PR) QLABORa(a);
    619   Coefficient (all,a,PR) VLABORa(a);
    620   Coefficient (all,z,CZ)  SHR_QLABORz(z);
    621    
    622   Formula
    623     (all,a,PR) QLABORa(a)                    = sum{z, CZ:CZ2PR(z) = a, QLABORz(z)};
    624     (all,a,PR) VLABORa(a)                    = sum{z, CZ:CZ2PR(z) = a, VLABORz(z)};
    625     (all,z,CZ)  SHR_QLABORz(z)                = QLABORz(z) / QLABORa(CZ2PR(z));
    626    
    627   Equation
    628   E_VLABORz (all,z,CZ)   p_VLABORz(z)                   = p_QLABORz(z) + p_PLABORz(z) ;
    629   !E_QLABORa  (all,a,PR) QLABORa(a) * p_QLABORa(a)      = sum{z, CZ:CZ2PR(z) = a, QLABORz(z) * p_QLABORz(z)};!
    630   E_QLABORa (all,a,PR) p_QLABORa(a) = sum{z, CZ:CZ2PR(z) = a, SHR_QLABORz(z) * p_QLABORz(z)};
    631   E_VLABORa  (all,a,PR) VLABORa(a) * p_VLABORa(a)      = sum{z, CZ:CZ2PR(z) = a, VLABORz(z) * p_VLABORz(z)};
    632   E_PLABORa  (all,a,PR) p_VLABORa(a)                   = p_QLABORa(a) + p_PLABORa(a);
    633    
    634   ! calculate land market outcomes at PR!
    635   Variable (all,z,CZ)  p_VLANDz(z);
    636   Variable (all,a,PR) p_PLANDa(a);
    637   Variable (all,a,PR) p_QLANDa(a);
    638   Variable (all,a,PR) p_VLANDa(a);
    639    
    640   Coefficient (all,a,PR) QLANDa(a);
    641   Coefficient (all,a,PR) VLANDa(a);
    642    
    643   Formula
    644     (all,a,PR) QLANDa(a)                    = sum{z, CZ:CZ2PR(z) = a, QLANDz(z)};
    645     (all,a,PR) VLANDa(a)                    = sum{z, CZ:CZ2PR(z) = a, VLANDz(z)};
    646    
    647   Equation
    648   E_VLANDz (all,z,CZ)   p_VLANDz(z)                   = p_QLANDz(z) + p_PLANDz(z) ;
    649   E_QLANDa  (all,a,PR) QLANDa(a) * p_QLANDa(a)      = sum{z, CZ:CZ2PR(z) = a, QLANDz(z) * p_QLANDz(z)};
